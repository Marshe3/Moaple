<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aischool.mapper.UsersMapper">
	<insert id="UsersJoin" parameterType="com.aischool.entity.Users">
		<!-- 쿼리문 작성 -->
		INSERT INTO USERS(trackId, userName, password, name, projectTeamName, phone, profileImg)
		VALUES (#{trackId}, #{userName}, #{password}, #{name}, #{projectTeamName}, #{phone}, #{profileImg})
	</insert>
	
	<select id="checkUserName" parameterType="String" resultType="int">
		SELECT COUNT(*) FROM USERS WHERE userName = #{userName}
	</select>
	
	<select id="login" parameterType="com.aischool.entity.Users" resultType="com.aischool.entity.Users">
		SELECT * FROM Users WHERE userName = #{userName}
	</select>
	
	<select id="getUser" parameterType="int" resultType="com.aischool.entity.Users">
		SELECT * FROM Users WHERE userId = #{userId}
	</select>
</mapper>